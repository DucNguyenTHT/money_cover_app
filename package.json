{
  "name": "ketoan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @ketoan/e2e e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @ketoan/api db:generate",
    "db:migrate": "pnpm --filter @ketoan/api db:migrate",
    "db:seed": "pnpm --filter @ketoan/api db:seed",
    "db:reset": "pnpm --filter @ketoan/api db:reset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "eslint": "^9.25.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "^3.5.3",
    "turbo": "^2.5.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  }
}
