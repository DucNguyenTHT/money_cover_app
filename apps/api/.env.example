DATABASE_URL="postgresql://ketoan:ketoan@localhost:5433/ketoan?schema=public"
DATABASE_URL_TEST="postgresql://ketoan:ketoan@localhost:5433/ketoan_test?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
