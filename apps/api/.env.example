# Database backup in dev: pg_dump runs inside the Postgres container.
BACKUP_DIR="storage/backups"
BACKUP_PG_DUMP="docker exec -i ketoannoibo-db-1 pg_dump"
BACKUP_DATABASE_URL="postgresql://ketoan:ketoan@localhost:5432/ketoan"
