// Money columns: Decimal(16,2) in VND. Quantities: Decimal(16,4) in the ingredient's stock unit.
// "*ById" columns that only record who did something are plain ints (no relation) to keep the model lean.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums
// Keep values identical to src/domain/enums.ts (checked by tests/enums-sync.test.ts).

enum Role {
  ADMIN
  STAFF
  KITCHEN
}

enum Station {
  KITCHEN
  BAR
}

enum IngredientKind {
  INGREDIENT
  PACKAGING
  /// Bán thành phẩm (nước dùng, sốt…): nấu theo mẻ từ nguyên liệu, rồi món dùng như một nguyên liệu.
  SEMI
}

enum PriceType {
  STORE
  APP
}

enum RecipeScope {
  ALL
  TAKEAWAY_APP
}

enum PrinterRole {
  BILL
  KITCHEN
  BAR
}

enum Channel {
  DINE_IN
  TAKEAWAY
  APP
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

enum CancelKind {
  CANCELLED
  MERGED
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum VatMode {
  EXCLUSIVE
  INCLUSIVE
}

enum KitchenStatus {
  NEW
  SENT
  DONE
  SERVED
}

enum ItemStatus {
  ACTIVE
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  APP
}

enum ReceiptKind {
  PURCHASE
  OPENING
}

enum IssueReason {
  SALE_USE
  DISPOSAL
  SUPPLIER_RETURN
  INTERNAL_USE
  /// Nguyên liệu đem nấu bán thành phẩm (phiếu chế biến).
  PRODUCTION
}

enum StocktakeStatus {
  DRAFT
  DONE
  CANCELLED
}

enum DocumentKind {
  PURCHASE
  SALE
  OTHER
}

/// Business line for household tax (tỷ lệ % trên doanh thu). Rates live in src/domain/tax/household.ts.
enum CashDirection {
  IN
  OUT
}

enum PayType {
  HOURLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  CLOSED
}

enum TaxGroup {
  DISTRIBUTION
  SERVICE
  PRODUCTION
  OTHER
}

/// DAILY = báo cáo khi chốt ngày, MORNING = tin nhắc việc buổi sáng, ALERT = cảnh báo ngay.
enum NotifyKind {
  DAILY
  MORNING
  ALERT
}

/// Dịch vụ báo biến động số dư mà quán dùng.
enum BankProvider {
  SEPAY
  CASSO
}

/// CODE = nội dung chuyển khoản có mã đơn; AMOUNT = đúng số tiền một máy POS đang chờ; MANUAL = người gán.
enum MatchKind {
  CODE
  AMOUNT
  MANUAL
}

/// Nhà cung cấp hoá đơn điện tử: MOCK = giả lập để thử (không gửi cơ quan thuế), SEPAY = SePay eInvoice.
enum EInvoiceProvider {
  MOCK
  SEPAY
}

/// PENDING = chờ gửi, SENDING = nhà cung cấp đang xử lý, ISSUED = đã phát hành, FAILED = bị từ chối, CANCELLED = huỷ trước khi gửi.
enum EInvoiceStatus {
  PENDING
  SENDING
  ISSUED
  FAILED
  CANCELLED
}

/// EARN = tích khi thanh toán, REDEEM = đổi điểm trừ tiền, ADJUST = ADMIN chỉnh tay, REVERSE = hoàn khi huỷ đơn.
enum PointKind {
  EARN
  REDEEM
  ADJUST
  REVERSE
}

enum PromotionKind {
  TIME
  COMBO
}

enum ReservationStatus {
  BOOKED
  ARRIVED
  CANCELLED
  NO_SHOW
}

enum DepositOutcome {
  USED
  REFUNDED
  KEPT
}

enum TableRequestKind {
  ORDER
  CALL
  BILL
}

enum TableRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// ORIGINAL = hoá đơn của đơn bán; ADJUSTMENT = hoá đơn điều chỉnh giảm toàn bộ khi đơn đã phát hành bị huỷ.
enum EInvoiceKind {
  ORIGINAL
  ADJUSTMENT
}

// ---------------------------------------------------------------- catalog & config

/// Cơ sở
/// Quán / chi nhánh. Hiện chỉ dùng 1 cơ sở; giữ bảng để sau này mở thêm chi nhánh.
/// Lưu: mã, tên, địa chỉ, điện thoại.
model Branch {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("branches")
}

/// Tài khoản
/// Người dùng đăng nhập app, phân quyền ADMIN / STAFF / KITCHEN.
/// Lưu: tên đăng nhập, mật khẩu và mã PIN duyệt (đã băm), họ tên, vai trò, trạm bếp / bar, số lần nhập sai PIN.
model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  passwordHash       String    @map("password_hash")
  pinHash            String?   @map("pin_hash")
  pinFailedCount     Int       @default(0) @map("pin_failed_count")
  pinLockedUntil     DateTime? @map("pin_locked_until") @db.Timestamptz
  fullName           String    @map("full_name")
  role               Role
  station            Station?
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("users")
}

/// Nguyên liệu
/// Danh mục nguyên liệu và bao bì dùng trong định mức món, nhập / xuất / kiểm kê kho.
/// Lưu: mã, tên, loại (nguyên liệu / bao bì), đơn vị kho, đơn vị định mức và hệ số quy đổi, đơn vị mua (thùng, bao…), nhóm, tồn tối thiểu.
model Ingredient {
  id             Int            @id @default(autoincrement())
  code           String         @unique
  name           String
  kind           IngredientKind @default(INGREDIENT)
  unit           String
  recipeUnit     String         @map("recipe_unit")
  recipeFactor   Decimal        @default(1) @map("recipe_factor") @db.Decimal(16, 4)
  purchaseUnit   String?        @map("purchase_unit")
  purchaseFactor Decimal        @default(1) @map("purchase_factor") @db.Decimal(16, 4)
  /// Tồn tối thiểu (đơn vị kho): dưới mức này là "sắp hết", gợi ý nhập hàng
  minStock       Decimal?       @map("min_stock") @db.Decimal(16, 4)
  category       String?
  active         Boolean        @default(true)

  recipeItems    DishRecipeItem[]
  receiptItems   ReceiptItem[]
  lots           Lot[]
  issueItems     IssueItem[]
  stocktakeItems StocktakeItem[]
  optionItems    OptionIngredient[]
  orderExtras    OrderItemExtra[]
  semiRecipes    SemiRecipe[]
  semiInputs     SemiRecipeItem[]
  productions    Production[]

  @@map("ingredients")
}

/// Nhóm món
/// Nhóm thực đơn: quyết định món hiện ở trạm bếp hay bar, và % nguyên liệu mục tiêu khi gợi ý giá.
/// Lưu: tên, trạm, % food cost mục tiêu, thứ tự.
model DishCategory {
  id             Int      @id @default(autoincrement())
  name           String
  foodCostTarget Decimal? @map("food_cost_target") @db.Decimal(5, 2)
  station        Station  @default(KITCHEN)
  /// Ngành thuế của doanh thu nhóm này (hộ kinh doanh): ăn uống = PRODUCTION (3% GTGT).
  taxGroup       TaxGroup @default(PRODUCTION) @map("tax_group")
  sort           Int      @default(0)

  dishes         Dish[]
  promotionItems PromotionItem[]

  @@map("dish_categories")
}

/// Món
/// Món bán trên thực đơn POS.
/// Lưu: mã, tên, nhóm, ảnh, đang bán hay ngừng, ngày bị báo hết món, thứ tự.
model Dish {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  categoryId  Int       @map("category_id")
  imageUrl    String?   @map("image_url")
  active      Boolean   @default(true)
  /// Business date on which the dish was marked sold out; sold out only while it equals today's business date.
  soldOutDate DateTime? @map("sold_out_date") @db.Date
  sort        Int       @default(0)

  category             DishCategory              @relation(fields: [categoryId], references: [id])
  prices               DishPrice[]
  recipes              DishRecipe[]
  optionGroups         DishOptionGroup[]
  orderItems           OrderItem[]
  stocktakeAllocations StocktakeDishAllocation[]
  promotionItems       PromotionItem[]

  @@map("dishes")
}

/// Giá bán món
/// Lịch sử giá bán theo ngày áp dụng; đơn hàng lấy giá có hiệu lực tại ngày bán.
/// Lưu: loại giá (tại quán / app), app riêng (trống = mọi app), giá, áp dụng từ ngày, người đổi.
model DishPrice {
  id            Int       @id @default(autoincrement())
  dishId        Int       @map("dish_id")
  priceType     PriceType @map("price_type")
  /// Only for APP prices: the delivery app this price is for; null = every app without its own price.
  deliveryAppId Int?      @map("delivery_app_id")
  price         Decimal   @db.Decimal(16, 2)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  createdById   Int?      @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  dish        Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
  deliveryApp DeliveryApp? @relation(fields: [deliveryAppId], references: [id], onDelete: Cascade)

  /// NULLS NOT DISTINCT (set in the migration): one general price per dish, type and day.
  @@unique([dishId, priceType, deliveryAppId, effectiveFrom])
  @@map("dish_prices")
}

/// Định mức món
/// Mỗi lần đổi công thức tạo một phiên bản theo ngày hiệu lực; đơn cũ giữ định mức cũ.
/// Lưu: món, ngày hiệu lực, ghi chú.
model DishRecipe {
  id            Int      @id @default(autoincrement())
  dishId        Int      @map("dish_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  dish       Dish             @relation(fields: [dishId], references: [id], onDelete: Cascade)
  items      DishRecipeItem[]
  orderItems OrderItem[]

  @@unique([dishId, effectiveFrom])
  @@map("dish_recipes")
}

/// Dòng định mức
/// Lượng từng nguyên liệu / bao bì cho 1 phần món: căn cứ để trừ kho khi bán và tính giá vốn.
/// Lưu: nguyên liệu, số lượng (đơn vị kho), áp dụng mọi kênh hay chỉ mang về / app.
model DishRecipeItem {
  id           Int         @id @default(autoincrement())
  recipeId     Int         @map("recipe_id")
  ingredientId Int         @map("ingredient_id")
  qty          Decimal     @db.Decimal(16, 4)
  scope        RecipeScope @default(ALL)

  recipe     DishRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId, scope])
  @@map("dish_recipe_items")
}

/// Nhóm tuỳ chọn
/// Nhóm tuỳ chọn dùng chung cho nhiều món: Size (chọn 1), Thêm topping (chọn nhiều), Yêu cầu (ít cay…).
/// Lưu: tên, chọn 1 hay nhiều, bắt buộc, số lựa chọn tối đa, thứ tự, đang dùng.
model OptionGroup {
  id        Int     @id @default(autoincrement())
  name      String
  /// true = chọn nhiều (topping); false = chọn 1 (size)
  multi     Boolean @default(false)
  required  Boolean @default(false)
  /// Chọn nhiều: tối đa bao nhiêu lựa chọn (null = không giới hạn)
  maxSelect Int?    @map("max_select")
  sort      Int     @default(0)
  active    Boolean @default(true)

  options Option[]
  dishes  DishOptionGroup[]

  @@map("option_groups")
}

/// Tuỳ chọn
/// Một lựa chọn trong nhóm: Size lớn, Thêm trứng, Ít cay…
/// Lưu: tên, tiền cộng thêm, hệ số nhân định mức (size), chọn sẵn, thứ tự, đang dùng.
model Option {
  id           Int     @id @default(autoincrement())
  groupId      Int     @map("group_id")
  name         String
  /// Tiền cộng thêm vào giá món (mọi kênh)
  price        Decimal @default(0) @db.Decimal(16, 2)
  /// Nhân toàn bộ định mức món (Size lớn 1,5; nhỏ 0,8); 1 = không đổi
  recipeFactor Decimal @default(1) @map("recipe_factor") @db.Decimal(8, 4)
  isDefault    Boolean @default(false) @map("is_default")
  sort         Int     @default(0)
  active       Boolean @default(true)

  group       OptionGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredients OptionIngredient[]
  orderItems  OrderItemOption[]

  @@index([groupId])
  @@map("options")
}

/// Nguyên liệu của tuỳ chọn
/// Nguyên liệu trừ thêm khi chọn tuỳ chọn (Thêm trứng → 1 quả trứng).
/// Lưu: tuỳ chọn, nguyên liệu, số lượng mỗi phần (đơn vị kho).
model OptionIngredient {
  id           Int     @id @default(autoincrement())
  optionId     Int     @map("option_id")
  ingredientId Int     @map("ingredient_id")
  qty          Decimal @db.Decimal(16, 4)

  option     Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([optionId, ingredientId])
  @@map("option_ingredients")
}

/// Tuỳ chọn của món
/// Món nào dùng nhóm tuỳ chọn nào, theo thứ tự hiện trên POS.
/// Lưu: món, nhóm tuỳ chọn, thứ tự.
model DishOptionGroup {
  dishId  Int @map("dish_id")
  groupId Int @map("group_id")
  sort    Int @default(0)

  dish  Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([dishId, groupId])
  @@map("dish_option_groups")
}

/// Khu vực
/// Nhóm bàn trên sơ đồ bàn (tầng 1, sân…).
/// Lưu: tên, thứ tự.
model Area {
  id     Int           @id @default(autoincrement())
  name   String
  sort   Int           @default(0)
  tables DiningTable[]

  @@map("areas")
}

/// Bàn
/// Bàn trên sơ đồ bàn của POS.
/// Lưu: khu vực, tên bàn, số chỗ, thứ tự, đang dùng.
model DiningTable {
  id      Int     @id @default(autoincrement())
  areaId  Int     @map("area_id")
  name    String
  seats   Int     @default(4)
  sort    Int     @default(0)
  active  Boolean @default(true)
  /// Mã trong QR gọi món dán trên bàn (đổi mã = QR cũ hết dùng được).
  qrToken String? @unique @map("qr_token")

  area          Area           @relation(fields: [areaId], references: [id])
  orders        Order[]
  reservations  Reservation[]
  tableRequests TableRequest[]

  @@map("tables")
}

/// App giao hàng
/// Các app giao đồ ăn và % chiết khấu, trừ vào lãi của đơn kênh App; món có thể có giá riêng cho từng app.
/// Lưu: tên app, % hoa hồng, đang dùng.
model DeliveryApp {
  id            Int     @id @default(autoincrement())
  name          String
  commissionPct Decimal @map("commission_pct") @db.Decimal(5, 2)
  active        Boolean @default(true)

  orders     Order[]
  dishPrices DishPrice[]

  @@map("delivery_apps")
}

/// Máy in
/// Máy in nhiệt trong LAN để in bill, phiếu bếp, phiếu bar.
/// Lưu: tên, IP, cổng, khổ giấy, vai trò.
model Printer {
  id         Int         @id @default(autoincrement())
  name       String
  ip         String
  port       Int         @default(9100)
  paperWidth Int         @default(80) @map("paper_width")
  role       PrinterRole
  active     Boolean     @default(true)

  @@map("printers")
}

/// Chi phí chung
/// Chi phí cố định theo tháng: trừ vào lợi nhuận ròng và dùng tính % chi phí chung khi định giá.
/// Lưu: năm, tháng, khoản mục, số tiền, ghi chú.
model OverheadExpense {
  id       Int     @id @default(autoincrement())
  branchId Int     @map("branch_id")
  year     Int
  month    Int
  category String
  amount   Decimal @db.Decimal(16, 2)
  note     String?

  @@index([branchId, year, month])
  @@map("overhead_expenses")
}

/// Cài đặt
/// Cấu hình chung dạng khoá – giá trị.
/// Lưu: giờ bắt đầu ngày kinh doanh, thuế, phụ thu, mức giảm tối đa, VietQR, chế độ in, giờ sao lưu…; Google Client ID / secret, kết nối Drive, mã bot Telegram (mã hoá), kết quả sao lưu gần nhất.
model Setting {
  key   String @id
  value Json

  @@map("settings")
}

// ---------------------------------------------------------------- sales

/// Bộ đếm mã đơn
/// Cấp số thứ tự đơn trong mỗi ngày kinh doanh (mã đơn dạng 261016-012).
/// Lưu: ngày kinh doanh, số cuối đã cấp.
model OrderCounter {
  branchId     Int      @map("branch_id")
  businessDate DateTime @map("business_date") @db.Date
  lastNo       Int      @default(0) @map("last_no")

  @@id([branchId, businessDate])
  @@map("order_counters")
}

/// Đơn hàng
/// Mỗi lần bán (tại bàn / mang về / app) — nguồn duy nhất của doanh thu.
/// Lưu: mã đơn, ngày kinh doanh, kênh, bàn / app, trạng thái, tiền hàng, giảm giá, phụ thu, VAT, doanh thu thuần, tổng khách trả, chiết khấu app, giá vốn, người mở / thu / huỷ.
model Order {
  id                   Int           @id @default(autoincrement())
  branchId             Int           @map("branch_id")
  code                 String        @unique
  businessDate         DateTime      @map("business_date") @db.Date
  channel              Channel
  tableId              Int?          @map("table_id")
  deliveryAppId        Int?          @map("delivery_app_id")
  appOrderCode         String?       @map("app_order_code")
  guestCount           Int           @default(1) @map("guest_count")
  status               OrderStatus   @default(OPEN)
  splitFromOrderId     Int?          @map("split_from_order_id")
  subtotal             Decimal       @default(0) @db.Decimal(16, 2)
  itemDiscountTotal    Decimal       @default(0) @map("item_discount_total") @db.Decimal(16, 2)
  orderDiscountType    DiscountType? @map("order_discount_type")
  orderDiscountValue   Decimal?      @map("order_discount_value") @db.Decimal(16, 2)
  orderDiscountAmount  Decimal       @default(0) @map("order_discount_amount") @db.Decimal(16, 2)
  discountReason       String?       @map("discount_reason")
  discountApprovedById Int?          @map("discount_approved_by")
  serviceChargePct     Decimal       @default(0) @map("service_charge_pct") @db.Decimal(5, 2)
  serviceChargeAmount  Decimal       @default(0) @map("service_charge_amount") @db.Decimal(16, 2)
  /// Doanh thu thuần = subtotal − discounts + service charge (excludes VAT).
  netRevenue           Decimal       @default(0) @map("net_revenue") @db.Decimal(16, 2)
  vatPct               Decimal       @default(0) @map("vat_pct") @db.Decimal(5, 2)
  vatMode              VatMode       @default(EXCLUSIVE) @map("vat_mode")
  vatAmount            Decimal       @default(0) @map("vat_amount") @db.Decimal(16, 2)
  /// What the customer pays.
  total                Decimal       @default(0) @db.Decimal(16, 2)
  appCommission        Decimal       @default(0) @map("app_commission") @db.Decimal(16, 2)
  costTotal            Decimal       @default(0) @map("cost_total") @db.Decimal(16, 2)
  note                 String?
  /// Provisional bill printed: the table shows "chờ thanh toán".
  billPrintedAt        DateTime?     @map("bill_printed_at") @db.Timestamptz
  version              Int           @default(0)
  openedById           Int           @map("opened_by")
  openedAt             DateTime      @default(now()) @map("opened_at") @db.Timestamptz
  paidById             Int?          @map("paid_by")
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz
  cancelledById        Int?          @map("cancelled_by")
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelKind           CancelKind?   @map("cancel_kind")
  cancelReason         String?       @map("cancel_reason")
  /// Khách quen của đơn (tích / đổi điểm).
  customerId           Int?          @map("customer_id")
  /// Điểm khách đổi lấy tiền trên đơn này và số tiền được trừ (trừ sau giảm giá đơn, trước phụ thu / VAT).
  pointsRedeemed       Int           @default(0) @map("points_redeemed")
  pointsDiscount       Decimal       @default(0) @map("points_discount") @db.Decimal(16, 2)
  /// Điểm tích được khi thanh toán (để hoàn khi huỷ, in trên bill).
  pointsEarned         Int           @default(0) @map("points_earned")
  /// Tổng tiền khuyến mãi tự động (giờ vàng, combo) của các dòng — không tính vào giới hạn giảm giá của nhân viên.
  promoDiscountTotal   Decimal       @default(0) @map("promo_discount_total") @db.Decimal(16, 2)

  table            DiningTable?      @relation(fields: [tableId], references: [id])
  deliveryApp      DeliveryApp?      @relation(fields: [deliveryAppId], references: [id])
  items            OrderItem[]
  payments         OrderPayment[]
  issues           Issue[]
  bankTransactions BankTransaction[]
  einvoices        EInvoice[]
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservation      Reservation?

  @@index([businessDate, status])
  @@index([tableId, status])
  @@map("orders")
}

/// Món trong đơn
/// Từng món khách gọi, kèm trạng thái chế biến ở bếp.
/// Lưu: món, phiên bản định mức, trạm, số lượng, đơn giá, giảm giá, thành tiền, giá vốn, trạng thái bếp, huỷ / bỏ đi.
model OrderItem {
  id             Int           @id @default(autoincrement())
  orderId        Int           @map("order_id")
  dishId         Int           @map("dish_id")
  recipeId       Int?          @map("recipe_id")
  station        Station
  qty            Int
  /// Giá món (theo kênh / app, chưa gồm tuỳ chọn); unitPrice = basePrice + tiền các tuỳ chọn
  basePrice      Decimal       @default(0) @map("base_price") @db.Decimal(16, 2)
  unitPrice      Decimal       @map("unit_price") @db.Decimal(16, 2)
  /// Tích hệ số định mức của các tuỳ chọn đã chọn (size)
  recipeFactor   Decimal       @default(1) @map("recipe_factor") @db.Decimal(8, 4)
  /// Các tuỳ chọn đã chọn (id tăng dần, nối bằng dấu phẩy) — gộp dòng chỉ khi giống nhau
  optionsKey     String        @default("") @map("options_key")
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(16, 2)
  discountReason String?       @map("discount_reason")
  /// Khuyến mãi tự động của dòng (giờ vàng / combo); dòng giảm giá tay thì không có.
  promoDiscount  Decimal       @default(0) @map("promo_discount") @db.Decimal(16, 2)
  promotionId    Int?          @map("promotion_id")
  amount         Decimal       @db.Decimal(16, 2)
  /// After item discount and the share of the order-level discount.
  netAmount      Decimal       @default(0) @map("net_amount") @db.Decimal(16, 2)
  costTotal      Decimal       @default(0) @map("cost_total") @db.Decimal(16, 2)
  note           String?
  kitchenStatus  KitchenStatus @default(NEW) @map("kitchen_status")
  kitchenBatch   Int?          @map("kitchen_batch")
  sentAt         DateTime?     @map("sent_at") @db.Timestamptz
  doneAt         DateTime?     @map("done_at") @db.Timestamptz
  servedAt       DateTime?     @map("served_at") @db.Timestamptz
  status         ItemStatus    @default(ACTIVE)
  cancelReason   String?       @map("cancel_reason")
  cancelledById  Int?          @map("cancelled_by")
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz
  wasted         Boolean       @default(false)
  /// Lúc gọi món (giờ vàng xét theo giờ này).
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotion Promotion?        @relation(fields: [promotionId], references: [id])
  dish      Dish              @relation(fields: [dishId], references: [id])
  recipe    DishRecipe?       @relation(fields: [recipeId], references: [id])
  options   OrderItemOption[]
  extras    OrderItemExtra[]

  @@index([orderId])
  @@index([station, kitchenStatus])
  @@map("order_items")
}

/// Tuỳ chọn trong đơn
/// Bản chụp tuỳ chọn khách chọn cho một dòng món, giữ nguyên dù sau này đổi tên / giá tuỳ chọn.
/// Lưu: dòng món, tuỳ chọn gốc, tên nhóm, tên, tiền cộng thêm.
model OrderItemOption {
  id          Int     @id @default(autoincrement())
  orderItemId Int     @map("order_item_id")
  optionId    Int?    @map("option_id")
  groupName   String  @map("group_name")
  name        String
  price       Decimal @db.Decimal(16, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    Option?   @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
  @@map("order_item_options")
}

/// Nguyên liệu thêm của dòng món
/// Bản chụp nguyên liệu trừ thêm cho mỗi phần do tuỳ chọn (Thêm trứng…), dùng khi trừ kho và phân bổ kiểm kê.
/// Lưu: dòng món, nguyên liệu, số lượng mỗi phần (đơn vị kho).
model OrderItemExtra {
  id           Int     @id @default(autoincrement())
  orderItemId  Int     @map("order_item_id")
  ingredientId Int     @map("ingredient_id")
  qty          Decimal @db.Decimal(16, 4)

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([orderItemId])
  @@index([ingredientId])
  @@map("order_item_extras")
}

/// Thanh toán
/// Các lần trả tiền của một đơn (một đơn có thể trả nhiều phương thức).
/// Lưu: phương thức, số tiền, tiền khách đưa, tiền thối.
model OrderPayment {
  id           Int           @id @default(autoincrement())
  orderId      Int           @map("order_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(16, 2)
  cashReceived Decimal?      @map("cash_received") @db.Decimal(16, 2)
  change       Decimal?      @db.Decimal(16, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_payments")
}

/// Chốt ngày
/// Đối chiếu tiền cuối mỗi ngày kinh doanh.
/// Lưu: tiền mặt dự kiến, tiền đếm được, chênh lệch, tổng theo phương thức, người chốt.
model DayClosing {
  id               Int      @id @default(autoincrement())
  branchId         Int      @map("branch_id")
  businessDate     DateTime @map("business_date") @db.Date
  expectedCash     Decimal  @map("expected_cash") @db.Decimal(16, 2)
  countedCash      Decimal  @map("counted_cash") @db.Decimal(16, 2)
  diff             Decimal  @db.Decimal(16, 2)
  expectedByMethod Json     @map("expected_by_method")
  note             String?
  needsReclose     Boolean  @default(false) @map("needs_reclose")
  closedById       Int      @map("closed_by")
  closedAt         DateTime @default(now()) @map("closed_at") @db.Timestamptz

  @@unique([branchId, businessDate])
  @@map("day_closings")
}

/// Khách quen
/// Khách hàng nhận diện bằng số điện thoại: tích điểm khi mua, đổi điểm trừ tiền, xem lịch sử ghé quán.
/// Lưu: số điện thoại, tên, ngày sinh, ghi chú, điểm hiện có, số lần ghé, tổng chi tiêu, lần ghé gần nhất, đang dùng.
model Customer {
  id          Int       @id @default(autoincrement())
  branchId    Int       @map("branch_id")
  /// Digits only, 0xxxxxxxxx (normalised from +84).
  phone       String    @unique
  name        String
  birthday    DateTime? @db.Date
  note        String?
  /// Balance = Σ point entries (kept here for quick reads).
  points      Int       @default(0)
  visits      Int       @default(0)
  totalSpent  Decimal   @default(0) @map("total_spent") @db.Decimal(16, 2)
  lastVisitAt DateTime? @map("last_visit_at") @db.Timestamptz
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  orders       Order[]
  pointEntries PointEntry[]
  reservations Reservation[]

  @@index([name])
  @@map("customers")
}

/// Khuyến mãi
/// Giờ vàng (giảm % món / nhóm món theo ngày, thứ, giờ) hoặc combo (bộ món giá trọn gói); tự áp vào đơn đang mở.
/// Lưu: tên, loại, bật / tắt, ngày bắt đầu / kết thúc, thứ trong tuần, khung giờ, kênh, % giảm hoặc giá combo.
model Promotion {
  id         Int           @id @default(autoincrement())
  branchId   Int           @map("branch_id")
  name       String
  kind       PromotionKind
  active     Boolean       @default(true)
  startDate  DateTime?     @map("start_date") @db.Date
  endDate    DateTime?     @map("end_date") @db.Date
  /// 1 = thứ Hai … 7 = Chủ nhật (theo ngày kinh doanh); rỗng = mọi ngày.
  weekdays   Int[]
  /// "HH:MM" theo giờ gọi món; cả hai rỗng = cả ngày; bắt đầu > kết thúc = qua nửa đêm.
  startTime  String?       @map("start_time")
  endTime    String?       @map("end_time")
  channels   Channel[]
  /// Giờ vàng: % giảm trên giá dòng (gồm tuỳ chọn).
  percent    Decimal?      @db.Decimal(5, 2)
  /// Combo: giá một bộ (tính trên giá món, tuỳ chọn vẫn cộng thêm).
  comboPrice Decimal?      @map("combo_price") @db.Decimal(16, 2)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  items      PromotionItem[]
  orderItems OrderItem[]

  @@map("promotions")
}

/// Món của khuyến mãi
/// Combo: món và số phần trong một bộ. Giờ vàng: món hoặc nhóm món được giảm (không có dòng nào = cả thực đơn).
/// Lưu: khuyến mãi, món hoặc nhóm món, số phần.
model PromotionItem {
  id          Int  @id @default(autoincrement())
  promotionId Int  @map("promotion_id")
  dishId      Int? @map("dish_id")
  categoryId  Int? @map("category_id")
  qty         Int  @default(1)

  promotion Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  dish      Dish?         @relation(fields: [dishId], references: [id])
  category  DishCategory? @relation(fields: [categoryId], references: [id])

  @@index([promotionId])
  @@map("promotion_items")
}

/// Đặt bàn
/// Khách đặt trước: giờ đến, số khách, bàn, tiền cọc. Khách đến thì mở đơn từ đặt bàn; tiền cọc trừ vào đơn khi thanh toán.
/// Lưu: tên, điện thoại, khách quen, số khách, giờ đến, thời lượng, bàn, ghi chú, tiền cọc (cách nhận, đã dùng / hoàn / giữ), trạng thái, đơn.
model Reservation {
  id             Int               @id @default(autoincrement())
  branchId       Int               @map("branch_id")
  name           String
  phone          String?
  customerId     Int?              @map("customer_id")
  guests         Int
  reservedAt     DateTime          @map("reserved_at") @db.Timestamptz
  /// Ngày kinh doanh của giờ đến.
  businessDate   DateTime          @map("business_date") @db.Date
  durationMin    Int               @default(120) @map("duration_min")
  tableId        Int?              @map("table_id")
  note           String?
  deposit        Decimal           @default(0) @db.Decimal(16, 2)
  /// Tiền mặt: tự ghi thu vào sổ quỹ ngày nhận cọc. Chuyển khoản: không vào két.
  depositMethod  PaymentMethod?    @map("deposit_method")
  depositOutcome DepositOutcome?   @map("deposit_outcome")
  status         ReservationStatus @default(BOOKED)
  orderId        Int?              @unique @map("order_id")
  cancelReason   String?           @map("cancel_reason")
  createdById    Int               @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table    DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  order    Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([branchId, businessDate])
  @@map("reservations")
}

/// Yêu cầu từ bàn (QR)
/// Khách quét mã QR trên bàn: gọi món, gọi nhân viên, xin thanh toán. Nhân viên nhận (món vào đơn của bàn) hoặc từ chối.
/// Lưu: bàn, loại, trạng thái, món khách chọn, ghi chú, mã máy khách, đơn nhận món, người xử lý, lý do từ chối, IP.
model TableRequest {
  id           Int                @id @default(autoincrement())
  branchId     Int                @map("branch_id")
  tableId      Int                @map("table_id")
  kind         TableRequestKind
  status       TableRequestStatus @default(PENDING)
  /// [{ dishId, qty, optionIds, note }] — giá tính lại khi nhận vào đơn.
  items        Json?
  note         String?
  /// Random id kept by the guest's phone: it sees only its own requests.
  clientId     String             @map("client_id")
  orderId      Int?               @map("order_id")
  handledById  Int?               @map("handled_by")
  handledAt    DateTime?          @map("handled_at") @db.Timestamptz
  rejectReason String?            @map("reject_reason")
  ip           String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  table DiningTable @relation(fields: [tableId], references: [id])

  @@index([status, createdAt])
  @@index([tableId, status])
  @@map("table_requests")
}

/// Lịch sử điểm
/// Mỗi lần điểm của khách thay đổi: tích, đổi, hoàn khi huỷ đơn, ADMIN chỉnh (có lý do).
/// Lưu: khách, đơn liên quan, loại, số điểm (+ / −), ghi chú, người làm.
model PointEntry {
  id          Int       @id @default(autoincrement())
  customerId  Int       @map("customer_id")
  orderId     Int?      @map("order_id")
  kind        PointKind
  points      Int
  note        String?
  createdById Int?      @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("point_entries")
}

/// Tiền chuyển khoản về
/// Tiền vào tài khoản ngân hàng của quán, đọc từ dịch vụ báo biến động số dư (SePay / Casso); khớp với đơn theo mã đơn trong nội dung chuyển khoản để biết khách đã trả thật.
/// Lưu: dịch vụ, mã giao dịch bên dịch vụ, số tài khoản, số tiền, nội dung, mã tham chiếu ngân hàng, thời điểm, ngày kinh doanh, đơn đã khớp (cách khớp, người gán), bỏ qua (lý do).
model BankTransaction {
  id           Int          @id @default(autoincrement())
  branchId     Int          @map("branch_id")
  provider     BankProvider
  externalId   String       @map("external_id")
  accountNo    String?      @map("account_no")
  amount       Decimal      @db.Decimal(16, 2)
  description  String
  reference    String?
  bankName     String?      @map("bank_name")
  transactedAt DateTime     @map("transacted_at") @db.Timestamptz
  businessDate DateTime     @map("business_date") @db.Date
  orderId      Int?         @map("order_id")
  matchKind    MatchKind?   @map("match_kind")
  matchedById  Int?         @map("matched_by")
  matchedAt    DateTime?    @map("matched_at") @db.Timestamptz
  /// Not sales money (owner's own transfer, a supplier refund…): left out of the checks.
  ignoredAt    DateTime?    @map("ignored_at") @db.Timestamptz
  ignoredById  Int?         @map("ignored_by")
  ignoreReason String?      @map("ignore_reason")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([branchId, businessDate])
  @@index([orderId])
  @@map("bank_transactions")
}

/// Hoá đơn điện tử
/// Hoá đơn khởi tạo từ máy tính tiền của một đơn đã thanh toán, gửi qua nhà cung cấp chọn trong Cài đặt; chờ ở đây và tự gửi lại khi mất mạng. Đơn đã phát hành bị huỷ → một hoá đơn điều chỉnh giảm.
/// Lưu: đơn, loại (gốc / điều chỉnh), nhà cung cấp, trạng thái, mã tham chiếu gửi nhà cung cấp, mã theo dõi, số hoá đơn, ký hiệu, link / mã tra cứu, số tiền, người mua, số lần thử, lỗi, lần thử sau, lúc phát hành.
model EInvoice {
  id            Int              @id @default(autoincrement())
  branchId      Int              @map("branch_id")
  orderId       Int              @map("order_id")
  kind          EInvoiceKind     @default(ORIGINAL)
  provider      EInvoiceProvider
  status        EInvoiceStatus   @default(PENDING)
  /// Our id of the request, sent to the provider: a retried request is never issued twice.
  referenceCode String           @unique @map("reference_code")
  trackingCode  String?          @map("tracking_code")
  invoiceNo     String?          @map("invoice_no")
  series        String?
  lookupUrl     String?          @map("lookup_url")
  lookupCode    String?          @map("lookup_code")
  amount        Decimal          @db.Decimal(16, 2)
  /// Company / person who asked for the invoice (null = retail customer).
  buyer         Json?
  attempts      Int              @default(0)
  lastError     String?          @map("last_error")
  nextAttemptAt DateTime         @default(now()) @map("next_attempt_at") @db.Timestamptz
  issuedAt      DateTime?        @map("issued_at") @db.Timestamptz
  /// ADJUSTMENT: the invoice it corrects.
  originalId    Int?             @map("original_id")
  createdById   Int?             @map("created_by")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@index([branchId, createdAt])
  @@map("einvoices")
}

// ---------------------------------------------------------------- inventory

/// Phiếu nhập
/// Nhập hàng từ nhà cung cấp, hoặc khai báo tồn đầu khi bắt đầu dùng app.
/// Lưu: loại phiếu, ngày, nhà cung cấp, ghi chú, người tạo.
model Receipt {
  id          Int         @id @default(autoincrement())
  branchId    Int         @map("branch_id")
  kind        ReceiptKind @default(PURCHASE)
  date        DateTime    @db.Date
  /// Name as written on the receipt (kept for old receipts and the list)
  supplier    String?
  supplierId  Int?        @map("supplier_id")
  note        String?
  createdById Int         @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  items       ReceiptItem[]
  documents   Document[]
  supplierRef Supplier?         @relation(fields: [supplierId], references: [id])
  payments    SupplierPayment[]

  @@index([branchId, date])
  @@map("receipts")
}

/// Dòng phiếu nhập
/// Từng nguyên liệu trong phiếu nhập; mỗi dòng sinh ra một lô hàng.
/// Lưu: nguyên liệu, số lượng và đơn giá theo đơn vị kho, số lượng theo đơn vị mua, thành tiền.
model ReceiptItem {
  id              Int      @id @default(autoincrement())
  receiptId       Int      @map("receipt_id")
  ingredientId    Int      @map("ingredient_id")
  /// Quantity in stock units.
  qty             Decimal  @db.Decimal(16, 4)
  /// Price per stock unit.
  unitPrice       Decimal  @map("unit_price") @db.Decimal(16, 4)
  /// Quantity as typed in purchase units (thùng, bao…), for display.
  purchaseUnitQty Decimal? @map("purchase_unit_qty") @db.Decimal(16, 4)
  amount          Decimal  @db.Decimal(16, 2)

  receipt    Receipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  lot        Lot?

  @@map("receipt_items")
}

/// Lô hàng
/// Đơn vị tính giá vốn FIFO: mỗi lần nhập (hoặc phần thừa khi kiểm kê) là một lô giữ giá riêng.
/// Lưu: nguyên liệu, ngày, đơn giá, số lượng nhập, số lượng còn lại.
model Lot {
  id              Int      @id @default(autoincrement())
  branchId        Int      @map("branch_id")
  ingredientId    Int      @map("ingredient_id")
  date            DateTime @db.Date
  unitPrice       Decimal  @map("unit_price") @db.Decimal(16, 4)
  qtyIn           Decimal  @map("qty_in") @db.Decimal(16, 4)
  qtyRemaining    Decimal  @map("qty_remaining") @db.Decimal(16, 4)
  receiptItemId   Int?     @unique @map("receipt_item_id")
  stocktakeItemId Int?     @map("stocktake_item_id")
  /// Lot made by a production (bán thành phẩm).
  productionId    Int?     @unique @map("production_id")

  ingredient           Ingredient            @relation(fields: [ingredientId], references: [id])
  receiptItem          ReceiptItem?          @relation(fields: [receiptItemId], references: [id])
  stocktakeItem        StocktakeItem?        @relation(fields: [stocktakeItemId], references: [id])
  production           Production?           @relation(fields: [productionId], references: [id])
  issueAllocations     IssueAllocation[]
  stocktakeAllocations StocktakeAllocation[]

  @@index([branchId, ingredientId, date])
  @@map("lots")
}

/// Công thức chế biến
/// Nguyên liệu để nấu một mẻ bán thành phẩm (vd 10 kg xương + 0,5 kg gia vị → 40 lít nước dùng); có phiên bản theo ngày.
/// Lưu: bán thành phẩm, ngày hiệu lực, sản lượng một mẻ (đơn vị kho), ghi chú.
model SemiRecipe {
  id            Int      @id @default(autoincrement())
  ingredientId  Int      @map("ingredient_id")
  effectiveFrom DateTime @map("effective_from") @db.Date
  yieldQty      Decimal  @map("yield_qty") @db.Decimal(16, 4)
  note          String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  ingredient Ingredient       @relation(fields: [ingredientId], references: [id])
  items      SemiRecipeItem[]

  @@unique([ingredientId, effectiveFrom])
  @@map("semi_recipes")
}

/// Dòng công thức chế biến
/// Lượng một nguyên liệu cho một mẻ bán thành phẩm.
/// Lưu: công thức, nguyên liệu, số lượng (đơn vị kho).
model SemiRecipeItem {
  id           Int     @id @default(autoincrement())
  recipeId     Int     @map("recipe_id")
  ingredientId Int     @map("ingredient_id")
  qty          Decimal @db.Decimal(16, 4)

  recipe     SemiRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("semi_recipe_items")
}

/// Phiếu chế biến
/// Một lần nấu bán thành phẩm: xuất nguyên liệu (FIFO) và nhập một lô thành phẩm có giá vốn = tiền nguyên liệu ÷ số lượng thu được.
/// Lưu: ngày, bán thành phẩm, số lượng thu được, giá vốn, phiếu xuất nguyên liệu, ghi chú, người tạo.
model Production {
  id           Int      @id @default(autoincrement())
  branchId     Int      @map("branch_id")
  date         DateTime @db.Date
  ingredientId Int      @map("ingredient_id")
  qty          Decimal  @db.Decimal(16, 4)
  costTotal    Decimal  @map("cost_total") @db.Decimal(16, 2)
  unitCost     Decimal  @map("unit_cost") @db.Decimal(16, 4)
  /// The PRODUCTION issue that took the inputs out of stock.
  issueId      Int      @unique @map("issue_id")
  note         String?
  createdById  Int      @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  lot        Lot?

  @@index([branchId, date])
  @@map("productions")
}

/// Phiếu xuất
/// Mọi lần hàng ra khỏi kho: bán hàng (tự động), huỷ, trả nhà cung cấp, dùng nội bộ.
/// Lưu: ngày, lý do, đơn / món liên quan, ghi chú, người tạo.
model Issue {
  id          Int         @id @default(autoincrement())
  branchId    Int         @map("branch_id")
  date        DateTime    @db.Date
  reason      IssueReason
  orderId     Int?        @map("order_id")
  orderItemId Int?        @map("order_item_id")
  note        String?
  createdById Int         @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  order Order?      @relation(fields: [orderId], references: [id])
  items IssueItem[]

  @@index([branchId, date, reason])
  @@map("issues")
}

/// Dòng phiếu xuất
/// Lượng nguyên liệu xuất và giá vốn của nó.
/// Lưu: nguyên liệu, số lượng, giá vốn, phần nợ kho chưa có lô và giá tạm.
model IssueItem {
  id               Int      @id @default(autoincrement())
  issueId          Int      @map("issue_id")
  ingredientId     Int      @map("ingredient_id")
  qty              Decimal  @db.Decimal(16, 4)
  costTotal        Decimal  @default(0) @map("cost_total") @db.Decimal(16, 2)
  /// Quantity not covered by any lot yet ("nợ kho"); valued at pendingUnitPrice until settled.
  pendingQty       Decimal  @default(0) @map("pending_qty") @db.Decimal(16, 4)
  pendingUnitPrice Decimal? @map("pending_unit_price") @db.Decimal(16, 4)
  /// Only for SUPPLIER_RETURN: the lot being returned.
  lotId            Int?     @map("lot_id")

  issue       Issue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  ingredient  Ingredient        @relation(fields: [ingredientId], references: [id])
  allocations IssueAllocation[]

  @@index([ingredientId, pendingQty])
  @@map("issue_items")
}

/// Phân bổ lô khi xuất
/// Dòng xuất đã lấy từ lô nào, bao nhiêu (FIFO) — để truy ngược giá vốn.
/// Lưu: lô, số lượng, đơn giá.
model IssueAllocation {
  id          Int     @id @default(autoincrement())
  issueItemId Int     @map("issue_item_id")
  lotId       Int     @map("lot_id")
  qty         Decimal @db.Decimal(16, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(16, 4)

  issueItem IssueItem @relation(fields: [issueItemId], references: [id], onDelete: Cascade)
  lot       Lot       @relation(fields: [lotId], references: [id])

  @@map("issue_allocations")
}

/// Phiếu kiểm kê
/// Đếm tồn thực tế để tính hao hụt.
/// Lưu: ngày, trạng thái (nháp / đã chốt / huỷ), người tạo, người chốt.
model Stocktake {
  id            Int             @id @default(autoincrement())
  branchId      Int             @map("branch_id")
  date          DateTime        @db.Date
  status        StocktakeStatus @default(DRAFT)
  note          String?
  createdById   Int             @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedById Int?            @map("completed_by")
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz

  items StocktakeItem[]

  @@map("stocktakes")
}

/// Dòng kiểm kê
/// So tồn sổ sách với tồn thực tế của từng nguyên liệu.
/// Lưu: tồn sổ, tồn thực tế, chênh lệch, giá trị thiếu (+) / thừa (−).
model StocktakeItem {
  id               Int      @id @default(autoincrement())
  stocktakeId      Int      @map("stocktake_id")
  ingredientId     Int      @map("ingredient_id")
  bookQty          Decimal  @map("book_qty") @db.Decimal(16, 4)
  actualQty        Decimal? @map("actual_qty") @db.Decimal(16, 4)
  diffQty          Decimal? @map("diff_qty") @db.Decimal(16, 4)
  /// Price used for a surplus when the ingredient was never purchased.
  surplusUnitPrice Decimal? @map("surplus_unit_price") @db.Decimal(16, 4)
  /// Shortage value (positive) or surplus value (negative).
  lossValue        Decimal  @default(0) @map("loss_value") @db.Decimal(16, 2)

  stocktake       Stocktake                 @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  ingredient      Ingredient                @relation(fields: [ingredientId], references: [id])
  allocations     StocktakeAllocation[]
  dishAllocations StocktakeDishAllocation[]
  surplusLots     Lot[]

  @@unique([stocktakeId, ingredientId])
  @@map("stocktake_items")
}

/// Phân bổ lô khi thiếu
/// Phần thiếu khi kiểm kê được trừ khỏi lô nào (FIFO).
/// Lưu: lô, số lượng, đơn giá.
model StocktakeAllocation {
  id              Int     @id @default(autoincrement())
  stocktakeItemId Int     @map("stocktake_item_id")
  lotId           Int     @map("lot_id")
  qty             Decimal @db.Decimal(16, 4)
  unitPrice       Decimal @map("unit_price") @db.Decimal(16, 4)

  stocktakeItem StocktakeItem @relation(fields: [stocktakeItemId], references: [id], onDelete: Cascade)
  lot           Lot           @relation(fields: [lotId], references: [id])

  @@map("stocktake_allocations")
}

/// Phân bổ hao hụt vào món
/// Chia giá trị hao hụt cho các món theo lượng đã dùng → ra lãi theo món sau kiểm kê.
/// Lưu: món (trống = hao hụt chung), lượng dùng, giá trị.
model StocktakeDishAllocation {
  id              Int     @id @default(autoincrement())
  stocktakeItemId Int     @map("stocktake_item_id")
  /// null = "hao hụt chung" (no dish used the ingredient in the period).
  dishId          Int?    @map("dish_id")
  usageQty        Decimal @map("usage_qty") @db.Decimal(16, 4)
  value           Decimal @db.Decimal(16, 2)

  stocktakeItem StocktakeItem @relation(fields: [stocktakeItemId], references: [id], onDelete: Cascade)
  dish          Dish?         @relation(fields: [dishId], references: [id])

  @@map("stocktake_dish_allocations")
}

// ---------------------------------------------------------------- money & staff

/// Sổ quỹ tiền mặt
/// Thu / chi tiền mặt ngoài bán hàng (chi chợ, rút tiền, nộp ngân hàng, trả NCC, trả lương…); chốt ngày tính vào tiền mặt phải có.
/// Lưu: ngày kinh doanh, thu / chi, khoản mục, số tiền, ghi chú, nguồn tự động, người ghi, huỷ (lý do).
model CashEntry {
  id            Int           @id @default(autoincrement())
  branchId      Int           @map("branch_id")
  businessDate  DateTime      @map("business_date") @db.Date
  direction     CashDirection
  category      String
  amount        Decimal       @db.Decimal(16, 2)
  note          String?
  /// Created by another screen: SUPPLIER_PAYMENT / PAYROLL (with its id); null = typed in the cash book
  source        String?
  sourceId      Int?          @map("source_id")
  createdById   Int           @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelledById Int?          @map("cancelled_by")
  cancelReason  String?       @map("cancel_reason")

  @@index([branchId, businessDate])
  @@index([source, sourceId])
  @@map("cash_entries")
}

/// Nhà cung cấp
/// Nơi mua nguyên liệu; công nợ = tổng phiếu nhập − tổng đã trả.
/// Lưu: tên, điện thoại, địa chỉ, ghi chú, đang dùng.
model Supplier {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  phone   String?
  address String?
  note    String?
  active  Boolean @default(true)

  receipts Receipt[]
  payments SupplierPayment[]

  @@map("suppliers")
}

/// Trả tiền nhà cung cấp
/// Mỗi lần trả nợ (tiền mặt thì tự ghi chi vào sổ quỹ).
/// Lưu: nhà cung cấp, ngày, số tiền, hình thức, phiếu nhập (nếu trả cho 1 phiếu), ghi chú, huỷ (lý do).
model SupplierPayment {
  id            Int       @id @default(autoincrement())
  branchId      Int       @map("branch_id")
  supplierId    Int       @map("supplier_id")
  date          DateTime  @db.Date
  amount        Decimal   @db.Decimal(16, 2)
  /// CASH / TRANSFER
  method        String
  receiptId     Int?      @map("receipt_id")
  note          String?
  createdById   Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById Int?      @map("cancelled_by")
  cancelReason  String?   @map("cancel_reason")

  supplier Supplier @relation(fields: [supplierId], references: [id])
  receipt  Receipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@map("supplier_payments")
}

/// Nhân viên
/// Người làm ở quán (có hoặc không có tài khoản đăng nhập), cách trả lương.
/// Lưu: tên, điện thoại, vị trí, lương theo giờ / theo tháng, mức lương, tài khoản gắn kèm, đang làm.
model Employee {
  id       Int     @id @default(autoincrement())
  name     String
  phone    String?
  position String?
  payType  PayType @default(HOURLY) @map("pay_type")
  /// HOURLY: per hour; MONTHLY: per month
  rate     Decimal @db.Decimal(16, 2)
  /// Login of this person (self check-in at the till)
  userId   Int?    @unique @map("user_id")
  active   Boolean @default(true)

  attendance   Attendance[]
  payrollLines PayrollLine[]
  advances     SalaryAdvance[]

  @@map("employees")
}

/// Ca làm
/// Ca mẫu để xếp lịch (ca sáng 06:00–14:00…).
/// Lưu: tên, giờ bắt đầu, giờ kết thúc, thứ tự, đang dùng.
model Shift {
  id     Int     @id @default(autoincrement())
  name   String
  /// "HH:mm"
  start  String
  end    String
  sort   Int     @default(0)
  active Boolean @default(true)

  attendance Attendance[]

  @@map("shifts")
}

/// Lịch & chấm công
/// Một dòng cho mỗi nhân viên mỗi ngày: ca được xếp và giờ vào / ra thực tế; giờ công tính từ giờ vào / ra.
/// Lưu: nhân viên, ngày, ca, giờ vào, giờ ra, ghi chú.
model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int       @map("employee_id")
  date       DateTime  @db.Date
  shiftId    Int?      @map("shift_id")
  checkIn    DateTime? @map("check_in") @db.Timestamptz
  checkOut   DateTime? @map("check_out") @db.Timestamptz
  note       String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance")
}

/// Bảng lương tháng
/// Lương của mọi nhân viên trong tháng; chốt thì ghi tổng vào chi phí chung tháng đó.
/// Lưu: tháng, trạng thái (nháp / đã chốt), người chốt, dòng chi phí chung đã tạo.
model Payroll {
  id                Int           @id @default(autoincrement())
  branchId          Int           @map("branch_id")
  year              Int
  month             Int
  status            PayrollStatus @default(DRAFT)
  closedAt          DateTime?     @map("closed_at") @db.Timestamptz
  closedById        Int?          @map("closed_by")
  overheadExpenseId Int?          @map("overhead_expense_id")

  lines PayrollLine[]

  @@unique([branchId, year, month])
  @@map("payrolls")
}

/// Dòng bảng lương
/// Lương một nhân viên trong tháng: giờ công × lương giờ (hoặc lương tháng) + thưởng − phạt; trừ tạm ứng ra số còn trả.
/// Lưu: nhân viên, giờ công, đơn giá, lương cơ bản, thưởng, phạt, tạm ứng, còn trả, ngày trả, ghi chú.
model PayrollLine {
  id         Int       @id @default(autoincrement())
  payrollId  Int       @map("payroll_id")
  employeeId Int       @map("employee_id")
  payType    PayType   @map("pay_type")
  hours      Decimal   @default(0) @db.Decimal(8, 2)
  rate       Decimal   @db.Decimal(16, 2)
  basePay    Decimal   @map("base_pay") @db.Decimal(16, 2)
  bonus      Decimal   @default(0) @db.Decimal(16, 2)
  deduction  Decimal   @default(0) @db.Decimal(16, 2)
  advance    Decimal   @default(0) @db.Decimal(16, 2)
  note       String?
  paidAt     DateTime? @map("paid_at") @db.Timestamptz
  /// CASH / TRANSFER
  paidMethod String?   @map("paid_method")

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([payrollId, employeeId])
  @@map("payroll_lines")
}

/// Tạm ứng lương
/// Tiền đưa trước cho nhân viên trong tháng; bảng lương tháng đó tự trừ. Tạm ứng tiền mặt tự ghi chi vào sổ quỹ.
/// Lưu: nhân viên, ngày, số tiền, hình thức (tiền mặt / chuyển khoản), ghi chú, người ghi, huỷ (lý do).
model SalaryAdvance {
  id            Int       @id @default(autoincrement())
  employeeId    Int       @map("employee_id")
  date          DateTime  @db.Date
  amount        Decimal   @db.Decimal(16, 2)
  /// CASH / TRANSFER
  method        String
  note          String?
  createdById   Int       @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledById Int?      @map("cancelled_by")
  cancelReason  String?   @map("cancel_reason")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
  @@map("salary_advances")
}

// ---------------------------------------------------------------- documents (scanned invoices)
// Archive only: documents never change stock or P&L figures. Rows and files are soft-deleted,
// the file itself stays on disk (UPLOAD_DIR) so nothing is ever lost.

/// Chứng từ
/// Hoá đơn / chứng từ mua bán được lưu trữ; không ảnh hưởng số liệu kho hay lãi lỗ.
/// Lưu: loại (mua vào / bán ra / khác), ngày, số hoá đơn, đối tác, số tiền, ghi chú, phiếu nhập liên quan, xoá mềm.
model Document {
  id          Int          @id @default(autoincrement())
  branchId    Int          @map("branch_id")
  kind        DocumentKind
  date        DateTime     @db.Date
  number      String?
  partner     String?
  amount      Decimal?     @db.Decimal(16, 2)
  note        String?
  receiptId   Int?         @map("receipt_id")
  createdById Int          @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz
  deletedById Int?         @map("deleted_by")

  receipt Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  files   DocumentFile[]

  @@index([branchId, date])
  @@index([receiptId])
  @@map("documents")
}

/// File chứng từ
/// Ảnh / PDF / XML của một chứng từ; file thật nằm trong thư mục storage/documents.
/// Lưu: tên file, loại, dung lượng, đường dẫn file và ảnh thu nhỏ, mã sha256 chống trùng, người tải, xoá mềm.
model DocumentFile {
  id             Int       @id @default(autoincrement())
  documentId     Int       @map("document_id")
  name           String
  mime           String
  size           Int
  /**
   * Relative to UPLOAD_DIR, e.g. 2026/10/<uuid>.jpg
   */
  path           String
  thumbPath      String?   @map("thumb_path")
  sha256         String
  createdById    Int       @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  /**
   * Telegram file_id once the file was sent to the backup chat: lets the server download it again
   * (Khôi phục ảnh chứng từ) when the file is lost on disk.
   */
  telegramFileId String?   @map("telegram_file_id")

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
  @@index([sha256])
  @@map("document_files")
}

// ---------------------------------------------------------------- system

/// Lịch sử sửa
/// Nhật ký mọi thao tác sửa / xoá / huỷ / khoá sổ, kèm lý do.
/// Lưu: đối tượng, hành động, lý do, dữ liệu trước và sau, người làm, người duyệt.
model AuditLog {
  id           Int      @id @default(autoincrement())
  entity       String
  entityId     String   @map("entity_id")
  action       String
  reason       String?
  before       Json?
  after        Json?
  userId       Int?     @map("user_id")
  approvedById Int?     @map("approved_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Tin nhắn Telegram
/// Báo cáo cuối ngày, tin nhắc việc buổi sáng và cảnh báo gửi chủ quán qua bot Telegram; chờ ở đây để gửi lại khi máy chủ mất mạng.
/// Lưu: loại tin, nội dung, khoá chống gửi trùng, số lần thử, lỗi gần nhất, lúc gửi được.
model TelegramMessage {
  id        Int        @id @default(autoincrement())
  kind      NotifyKind
  text      String
  /// Same key = same message (e.g. the morning digest of one day): queued only once.
  dedupeKey String?    @unique @map("dedupe_key")
  attempts  Int        @default(0)
  lastError String?    @map("last_error")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  sentAt    DateTime?  @map("sent_at") @db.Timestamptz

  @@index([sentAt, id])
  @@map("telegram_messages")
}

/// Khoá sổ tháng
/// Tháng đã khoá thì không được ghi hay sửa chứng từ của tháng đó.
/// Lưu: năm, tháng, người khoá, thời điểm.
model PeriodLock {
  id         Int      @id @default(autoincrement())
  branchId   Int      @map("branch_id")
  year       Int
  month      Int
  lockedById Int      @map("locked_by")
  lockedAt   DateTime @default(now()) @map("locked_at") @db.Timestamptz

  @@unique([branchId, year, month])
  @@map("period_locks")
}

/// Số liệu chốt tháng
/// Bản chụp lãi lỗ và lãi theo món lúc khoá sổ, để báo cáo tháng cũ không bị đổi.
/// Lưu: năm, tháng, các dòng lãi lỗ, lãi theo món (JSON).
model MonthlyClosing {
  id         Int      @id @default(autoincrement())
  branchId   Int      @map("branch_id")
  year       Int
  month      Int
  figures    Json
  dishProfit Json     @map("dish_profit")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

