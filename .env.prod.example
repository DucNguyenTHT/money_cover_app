# Copy to .env.prod on the shop server and fill in. Never commit .env.prod.

# Database password (any long random string).
DB_PASSWORD=
# Token signing key, at least 32 characters (e.g. output of: openssl rand -hex 32).
JWT_SECRET=
# Names / IPs the tablets use to open the app (comma separated). Give the server a fixed IP on the router.
SITE_HOSTS=pos.local, 192.168.1.10
PUBLIC_URL=https://pos.local

# Backups (scripts/backup-db.ps1): extra folder to copy each dump to — external drive or a cloud-synced folder.
BACKUP_COPY_DIR=

# Optional, usually left empty: the Google Drive client is entered in the app (Hệ thống → Cài đặt →
# Google Drive), which takes precedence. OAuth client of type "TVs and Limited Input devices";
# step by step: docs/setup-google-drive.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
